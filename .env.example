# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env ne doit jamais être versionné.

# --- Facebook ---------------------------------------------------------------

# Token d'accès utilisateur Facebook (Explorateur de l'API Graph). Permissions : voir README.md.
FB_USER_TOKEN=

# Application Meta (Meta for Developers > Paramètres > Général).
# Nécessaire uniquement pour échanger le token contre un token longue durée.
FB_APP_ID=
FB_APP_SECRET=

# Page à gérer (facultatif : vide = la première page du compte).
FB_PAGE_ID=

# Catalogue de produits (Commerce Manager > Catalogue > Paramètres).
CATALOG_ID=

# --- Campagnes : compte sandbox uniquement (aucune dépense possible) ---------

# ID du compte publicitaire sandbox, sous la forme act_<chiffres>.
AD_ACCOUNT_ID=

# Mode du compte : sandbox (vide = campagnes désactivées).
AD_ACCOUNT_MODE=sandbox

# Token de l'utilisateur système qui a la page et le compte sandbox
# (facultatif : vide = FB_USER_TOKEN).
ADS_ACCESS_TOKEN=

# --- Agent IA (Groq) ----------------------------------------------------------

# Clé API Groq : https://console.groq.com/keys
LLM_API_KEY=
