# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env ne doit jamais être versionné.

# --- Facebook ---------------------------------------------------------------

# Token d'accès utilisateur Facebook (Graph API Explorer ou Facebook Login).
# Permissions nécessaires : voir README.md.
FB_USER_TOKEN=

# Identifiant de l'application Meta (Meta for Developers > Paramètres > Général).
# Nécessaire uniquement pour échanger le token contre un token longue durée.
FB_APP_ID=

# Clé secrète de l'application Meta (même page). Ne jamais la partager.
FB_APP_SECRET=

# Identifiant de la page à gérer (facultatif).
# Laisser vide pour utiliser la première page du compte (ou la choisir dans l'interface web).
FB_PAGE_ID=

# Identifiant du catalogue de produits utilisé par les opérations catalogue
# (Commerce Manager > Catalogue > Paramètres).
CATALOG_ID=

# --- Campagnes : uniquement un compte qui ne peut rien dépenser ----------
# Quel que soit le mode, le code crée tout en PAUSED, refuse ACTIVE partout et impose le budget minimal.

# ID du compte publicitaire : act_<chiffres> ou <chiffres> (act_ est ajouté s'il manque).
AD_ACCOUNT_ID=

# Mode du compte (vide = domaine Campagnes désactivé) :
#   sandbox    : (recommandé) compte sandbox de l'app (Meta for Developers > votre app > Marketing API
#                > Outils), qui ne diffuse aucune publicité ; seul mode où les publicités sont possibles ;
#   no_payment : compte du Gestionnaire de publicités SANS moyen de paiement et sans dépense. Meta y
#                refuse toute publicité (create_ad est refusée avant l'envoi) ; campagnes et ensembles
#                restent possibles.
# Dans les deux modes, le compte est relu avant chaque écriture : funding_source absent et
# amount_spent = "0", sinon tout est refusé.
AD_ACCOUNT_MODE=

# Token généré dans Marketing API > Outils pour le compte sandbox (facultatif).
# Vide = FB_USER_TOKEN (il doit alors avoir ads_read et ads_management).
ADS_ACCESS_TOKEN=

# --- Lead Ads ------------------------------------------------------------

# Option : formulaires protégés, ID séparés par des virgules (vide = aucun formulaire protégé).
# Utile avec des formulaires qui reçoivent de vrais leads : le code ne les archive jamais et ne les
# utilise dans aucune publicité (agent et menu) ; pour en utiliser un, retirez son ID d'ici.
PROTECTED_LEAD_FORM_IDS=

# --- LLM ---------------------------

# URL de base de l'API. Laisser vide pour utiliser Groq (gratuit) :
# https://api.groq.com/openai/v1
LLM_BASE_URL=

# Clé API du fournisseur LLM (pour Groq : https://console.groq.com/keys).
LLM_API_KEY=

# Nom du modèle à utiliser. Laisser vide pour openai/gpt-oss-120b ;
# en secours : openai/gpt-oss-20b (voir https://console.groq.com/docs/models).
LLM_MODEL=

# Effort de raisonnement des modèles gpt-oss : low, medium ou high. Laisser vide pour low
# (moins de tokens consommés, voir https://console.groq.com/docs/reasoning).
LLM_REASONING_EFFORT=

# Nombre maximal de tokens produits par réponse du modèle (raisonnement compris).
# Laisser vide pour 1024 (valeur par défaut de Groq).
LLM_MAX_COMPLETION_TOKENS=

# Nombre d'échanges précédents (demande + outils + réponse) gardés en entier dans l'historique ;
# les plus anciens ne gardent que la demande et la réponse, et l'historique reste sous 2 500 tokens.
# Vide = 1.
LLM_HISTORY_EXCHANGES=

# Modèle du 1er appel de chaque demande (choix du domaine), avec son propre quota Groq.
# Laisser vide pour openai/gpt-oss-20b ; mettre la même valeur que LLM_MODEL pour n'utiliser qu'un modèle.
LLM_ROUTER_MODEL=
